# Copy this to .env and fill in real values.
# Never commit .env — it is gitignored.

# EVM wallet address that receives settled USDC payments from the x402 gateway
VITE_SELLER_ADDRESS=

# ERC-8004 agent ID on Arc Mainnet (written by scripts/register-agent.ts --network mainnet)
VITE_AGENT_ID_MAINNET=

# ERC-8004 agent ID on Arc Testnet (written by scripts/register-agent.ts)
VITE_AGENT_ID=

# Private key of the wallet that owns the agent NFT (used by register-agent.ts and set-agent-uri.ts only)
# NEVER expose this in the frontend or commit it.
AGENT_OWNER_PRIVATE_KEY=
